# dbt build artefacts. Everything here is regenerated by `dbt deps` / `dbt build`
# and is specific to one machine and one run.
target/
dbt_packages/
logs/

# An anonymous-usage id dbt writes per checkout. Not a secret, but it is not a
# property of the project either -- committing it would hand every clone the
# same identity.
.user.yml

# package-lock.yml is deliberately NOT ignored: it pins the exact dbt_utils
# revision `dbt deps` resolved, which is the same argument stack doc §3 makes
# for pinning every other version in this stack.
