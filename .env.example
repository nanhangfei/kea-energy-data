# Copy to .env and fill in. `.env` is gitignored (root .gitignore line 31) and
# must stay that way. Never put a real secret in this file — this one IS committed.
#
# This is the PIPELINE's env, separate from the repo-root .env used by the API
# and web services. The two are not shared: each project in the shared-platform
# setup carries its own, so a stale value cannot cross between them.

# --- Airflow ----------------------------------------------------------------
AIRFLOW_PG_PASSWORD=change-me-airflow-pg
AIRFLOW_ADMIN_PASSWORD=change-me-admin
# Airflow encrypts stored connection credentials with this. Generate one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Must be a FIXED shared value across the api-server/scheduler/dag-processor, or
# task supervisors are SIGKILLed with "Invalid auth token" (see docker-compose.yml).
AIRFLOW_WEBSERVER_SECRET=change-me-webserver-secret

# --- The lake, lineage, monitoring and secrets -------------------------------
# This stack is self-contained: its own MinIO, Marquez, Grafana and Vault, with
# their own volumes. Nothing here is shared with the sibling project at runtime.
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio
# One bucket with the design doc's prefixes inside it (s3://kea-lake/bronze/...).
KEA_LAKE_BUCKET=kea-lake
MARQUEZ_PG_PASSWORD=change-me-marquez-pg
GRAFANA_ADMIN_PASSWORD=change-me-grafana
VAULT_DEV_TOKEN=change-me-vault-token

# --- Airflow connections (injected from env, never hardcoded in DAGs) -------
# The '&' in these URIs is why the Makefile passes .env to containers with
# --env-file rather than sourcing it in a shell.
# Update the password inside the URI to match MINIO_ROOT_PASSWORD above.
AIRFLOW_CONN_MINIO_S3=aws://change-me-minio-user:change-me-minio@?endpoint_url=http%3A%2F%2Fminio%3A9000
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=
AIRFLOW_CONN_KEA_SERVING=postgres://kea:change-me-serving@kea-serving-db:5432/kea

# --- Snowflake --------------------------------------------------------------
# Shared account with the sibling project; SEPARATE database. dbt build drops
# and recreates what it owns, so a database boundary turns a wrong DBT_SCHEMA
# into a permission error instead of data loss.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=KEA
DBT_SCHEMA=kea_staging
# Key-pair auth — Snowflake blocks single-factor password logins.
# HOST is where the .p8 lives on your machine; the Makefile mounts it read-only.
# PATH is where it appears INSIDE a container. Keep them distinct.
SNOWFLAKE_PRIVATE_KEY_HOST=/absolute/path/to/snowflake.p8
SNOWFLAKE_PRIVATE_KEY_PATH=/keys/snowflake.p8

# --- The serving store ------------------------------------------------------
# Where the loader lands. NOT the application's database — that is ../infra's
# `db` on 5432, a separate instance, and the two are not synced yet.
KEA_SERVING_PASSWORD=change-me-serving

# --- Alerting ---------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Host paths -------------------------------------------------------------
# DockerOperator bind mounts are resolved by the HOST daemon, not inside
# Airflow, so it needs this directory as the host sees it. `make` exports this
# automatically; it is set here too so a bare `docker compose` does not warn.
HOST_PROJECT_DIR=/absolute/path/to/kea-energy-data
COMPOSE_NETWORK=kea_default

# --- Metabase (BI over the serving schema, and later Snowflake) -------------
METABASE_PG_PASSWORD=change-me-metabase
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change-me-metabase-admin
