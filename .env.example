# Copy to .env and fill in. `.env` is gitignored (root .gitignore line 31) and
# must stay that way. Never put a real secret in this file — this one IS committed.
#
# This is the PIPELINE's env, separate from the repo-root .env used by the API
# and web services. The two are not shared: each project in the shared-platform
# setup carries its own, so a stale value cannot cross between them.

# --- Airflow ----------------------------------------------------------------
AIRFLOW_PG_PASSWORD=change-me-airflow-pg
AIRFLOW_ADMIN_PASSWORD=change-me-admin
# Airflow encrypts stored connection credentials with this. Generate one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Must be a FIXED shared value across the api-server/scheduler/dag-processor, or
# task supervisors are SIGKILLed with "Invalid auth token" (see docker-compose.yml).
AIRFLOW_WEBSERVER_SECRET=change-me-webserver-secret

# --- The lake, lineage, monitoring and secrets -------------------------------
# This stack is self-contained: its own MinIO, Marquez, Grafana and Vault, with
# their own volumes. Nothing here is shared with the sibling project at runtime.
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio
# One bucket with the design doc's prefixes inside it (s3://kea-lake/bronze/...).
KEA_LAKE_BUCKET=kea-lake
MARQUEZ_PG_PASSWORD=change-me-marquez-pg
GRAFANA_ADMIN_PASSWORD=change-me-grafana
VAULT_DEV_TOKEN=change-me-vault-token

# --- Airflow connections (injected from env, never hardcoded in DAGs) -------
# The '&' in these URIs is why the Makefile passes .env to containers with
# --env-file rather than sourcing it in a shell.
# Update the password inside the URI to match MINIO_ROOT_PASSWORD above.
AIRFLOW_CONN_MINIO_S3=aws://change-me-minio-user:change-me-minio@?endpoint_url=http%3A%2F%2Fminio%3A9000
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=

# --- Extract credentials: three roles, three systems -------------------------
# kea_source_schema.sql creates these three roles with LOGIN and NO password,
# on purpose -- "set it out of band from the secret store, so no credential
# ever lands in this repo". `pipeline/scripts/ops/set_extract_roles.sh` sets them from the values here, and
# `make ingest-date` runs it first.
#
# Do NOT collapse these onto the superuser `kea` (KEA_SOURCE_PASSWORD below).
# It can read all three schemas plus gen_audit; using it would make a
# cross-system join at extract time SUCCEED, when the whole point of three
# roles is that it should fail. `make ingest-date`'s gate checks this, and
# Airflow is deliberately given no superuser connection at all.
#
# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# and paste the same value into the matching URI below.
KEA_EXTRACT_BILLING_PASSWORD=
KEA_EXTRACT_METERING_PASSWORD=
KEA_EXTRACT_CATALOGUE_PASSWORD=
AIRFLOW_CONN_KEA_SRC_BILLING=postgres://kea_extract_billing:change-me-billing@kea-source-db:5432/kea
AIRFLOW_CONN_KEA_SRC_METERING=postgres://kea_extract_metering:change-me-metering@kea-source-db:5432/kea
AIRFLOW_CONN_KEA_SRC_CATALOGUE=postgres://kea_extract_catalogue:change-me-catalogue@kea-source-db:5432/kea
KEA_EXTRACT_WEATHER_PASSWORD=
AIRFLOW_CONN_KEA_SRC_WEATHER=postgres://kea_extract_weather:change-me-weather@kea-source-db:5432/kea

# --- The lake summary's login: the Analysis step ----------------------------
# kea_lake_audit owns the lake_audit schema and nothing else: it can rebuild
# the four rollups the Lake dashboard reads, and read no source system at all.
# It exists so that the summary can run in Airflow (kea_daily_pipeline's
# `dashboards` group) without Airflow holding the superuser. `make dashboards`
# creates the role and sets this password (ops/set_lake_audit_role.sh).
# Generate it like the four above, and paste the same value into the URI.
KEA_LAKE_AUDIT_PASSWORD=
AIRFLOW_CONN_KEA_LAKE_AUDIT=postgres://kea_lake_audit:change-me-lake-audit@kea-source-db:5432/kea

# --- Snowflake --------------------------------------------------------------
# Kea's OWN account, not shared with the sibling project. Its own role and
# warehouse too: dbt build drops and recreates what it owns, so connecting as a
# least-privilege role turns a wrong DBT_SCHEMA into a permission error instead
# of data loss. ACCOUNTADMIN would not. See snowflake/bootstrap.sql, which
# creates all of it and is run once, by hand.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=KEA
DBT_SCHEMA=kea
# Key-pair auth — Snowflake blocks single-factor password logins.
# HOST is where the .p8 lives on your machine; the Makefile mounts it read-only.
# PATH is where it appears INSIDE a container. Keep them distinct.
SNOWFLAKE_PRIVATE_KEY_HOST=/absolute/path/to/snowflake.p8
SNOWFLAKE_PRIVATE_KEY_PATH=/keys/snowflake.p8

# --- The pipeline database and the served tables ----------------------------
# kea-source-db is the pipeline's own Postgres: the four source systems and
# the audit schemas, and no served tables. This is its superuser's password.
KEA_SOURCE_PASSWORD=change-me-source

# The served tables live in the backend's database (kea-db, ../infra), locally
# as in shared environments. `make publish-serving MIGRATE=1` creates these two
# roles there with LOGIN and no password; `make publish-serving ROLES=1` sets
# these, once per new database (rebuild-all passes it).
# kea_loader is what the publish connects as; kea_app is the agent's read-only
# role, which Soda's serving report also uses. Connecting as the owner instead
# would work and would quietly cost design §1.1's guarantee that a pipeline bug
# cannot reach app.*.
KEA_LOADER_PASSWORD=change-me-loader
KEA_APP_PASSWORD=change-me-app

# Explicit shared target used by `make publish-serving MIGRATE=1` and
# `make publish-serving RELEASE=...`. Both DSNs must name the same database,
# and the password in KEA_PUBLISH_DSN must be KEA_LOADER_PASSWORD.
# The migration identity owns Data schemas and can create roles. The publisher
# uses kea_loader and cannot access the backend-owned app schema; the serving
# gate (`make publish-serving`'s assert_serving step, and Airflow's) runs as it too.
# Airflow is given KEA_PUBLISH_DSN only -- migrating stays a manual owner step.
# host.docker.internal reaches the host's kea-db from the data Docker network.
KEA_MIGRATION_DSN=postgresql://kea:kea@host.docker.internal:5432/kea
KEA_PUBLISH_DSN=postgresql://kea_loader:change-me-loader@host.docker.internal:5432/kea

# The same database for the tools that take a host and port rather than a DSN:
# Metabase's "Kea serving" connection and Soda's serving report.
KEA_BACKEND_DB_HOST=host.docker.internal
KEA_BACKEND_DB_PORT=5432

# --- Alerting ---------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Host paths -------------------------------------------------------------
# DockerOperator bind mounts are resolved by the HOST daemon, not inside
# Airflow, so it needs this directory as the host sees it. `make` exports this
# automatically; it is set here too so a bare `docker compose` does not warn.
HOST_PROJECT_DIR=/absolute/path/to/kea-energy-data
COMPOSE_NETWORK=kea_default

# --- Metabase (BI over the serving schema, and later Snowflake) -------------
METABASE_PG_PASSWORD=change-me-metabase
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change-me-metabase-admin
